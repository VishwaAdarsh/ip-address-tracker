# Environment Configuration Template
# Copy this file to .env and configure values when required.

# Geolocation API Configuration (Primary provider: ipapi.co)
# Free tier allows up to 1,000 requests/day without key.
# If using a paid plan or custom key, specify GEO_API_KEY.
GEO_PROVIDER_NAME=ipapi.co
GEO_API_BASE_URL=https://ipapi.co
GEO_API_KEY=
GEO_API_TIMEOUT=5.0
