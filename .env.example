# ==============================================================================
# IP PULSE — Environment Configuration Template
# Copy this file to .env and configure values when needed.
# All settings have safe defaults and allow full offline/local operation.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Geolocation API Configuration (Primary provider: ipapi.co)
# ------------------------------------------------------------------------------
# Free tier allows up to 1,000 requests/day without an API key.
# If using a paid plan or custom key, set GEO_API_KEY below.
GEO_PROVIDER_NAME=ipapi.co
GEO_API_BASE_URL=https://ipapi.co
GEO_API_KEY=
GEO_API_TIMEOUT=5.0

# ------------------------------------------------------------------------------
# 2. AI Intelligence & Explanation Configuration (Phase 22)
# ------------------------------------------------------------------------------
# Supported AI_PROVIDER options:
#   - rule_based : Zero-configuration deterministic engine (default, no API key needed)
#   - gemini     : Google Gemini generative AI (requires AI_API_KEY or GEMINI_API_KEY)
#   - ollama     : Local Ollama LLM endpoint (default host: http://localhost:11434)
AI_PROVIDER=rule_based
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT=10.0
AI_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Server Configuration (Optional Overrides)
# ------------------------------------------------------------------------------
# Default host is 127.0.0.1 and default port is 8000.
# You can also override via command line: python app.py --host 127.0.0.1 --port 8080
HOST=127.0.0.1
PORT=8000

